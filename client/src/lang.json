  "welcome_title": {
    "en": "welcome to sprawling",
    "zh": "欢迎来到 sprawling"
  },
  "welcome_steps": {
    "en": "the five steps",
    "zh": "五步"
  },
  "welcome_step_machine": {
    "en": "this machine",
    "zh": "这台机器"
  },
  "welcome_step_provider": {
    "en": "a provider",
    "zh": "一个 provider"
  },
  "welcome_step_optional": {
    "en": "optional",
    "zh": "可选"
  },
  "welcome_step_model": {
    "en": "the model",
    "zh": "模型"
  },
  "welcome_step_go": {
    "en": "begin",
    "zh": "开始"
  },
  "welcome_machine_body": {
    "en": "Run this once in a terminal. It looks at what this machine has, tells you what a city needs, and offers to install each missing item one at a time — never silently.",
    "zh": "在终端里跑一次。它会看这台机器有什么、告诉你一座城需要什么，并逐项征询后安装缺的东西——从不悄悄装。"
  },
  "welcome_machine_note": {
    "en": "Nothing here is required to talk to the Mayor; a browser tool or a shell is needed only by a building that declares it.",
    "zh": "和 Mayor 说话不需要这里的任何东西；浏览器工具或 shell 只有声明了的楼才需要。"
  },
  "welcome_provider_body": {
    "en": "A city thinks with a model you bring. Give it a key, or sign in with a subscription; the key goes to your operating system's vault and never into a frame.",
    "zh": "一座城用你带来的模型思考。给它一个 key，或用订阅登录；key 进操作系统的凭据库，从不进帧。"
  },
  "welcome_optional_body": {
    "en": "Two things you can do now or later: connect a tool server to City Hall, and move the skills you already have into the shared folder.",
    "zh": "两件现在或以后都可以做的事：给市政厅接一个工具服务器，把你已有的 skills 搬进共享文件夹。"
  },
  "welcome_model_body": {
    "en": "Point main at the model that should think, and say how hard it should think when you say nothing.",
    "zh": "把 main 指向该思考的那个模型，再定一个你不特别说时它想多用力。"
  },
  "welcome_go_body": {
    "en": "That is all. Tell the Mayor what you want; it reads the whole city before it answers.",
    "zh": "就这些。告诉 Mayor 你想要什么；它会读遍这座城再回答。"
  },
  "welcome_no_main": {
    "en": "no model answers for main yet — go back one step, or a dispatch will be refused",
    "zh": "main 还没有模型——退回一步，否则派活会被拒"
  },
  "welcome_next": {
    "en": "next",
    "zh": "下一步"
  },
  "welcome_back": {
    "en": "back",
    "zh": "上一步"
  },
  "welcome_skip": {
    "en": "skip",
    "zh": "跳过"
  },
