            "cmd": "./dist-package/cursor-agent",
            "args": [
              "acp"
            ]
          },
          "linux-x86_64": {
            "cmd": "./dist-package/cursor-agent",
            "args": [
              "acp"
            ]
          },
          "windows-aarch64": {
            "cmd": "./dist-package\\cursor-agent.cmd",
            "args": [
              "acp"
            ]
          },
          "windows-x86_64": {
            "cmd": "./dist-package\\cursor-agent.cmd",
            "args": [
              "acp"
            ]
          }
        }
      }
    },
    {
      "id": "fast-agent",
      "name": "fast-agent",
      "version": "0.10.1",
      "description": "Code and build agents with comprehensive multi-provider support",
